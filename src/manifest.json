{
  "manifest_version": 3,
  "name": "FB Page Leads — Business Contact Scraper",
  "version": "0.1.0",
  "description": "Finds Facebook business pages by keyword and location, exports public contact details (phone, email, website, address) as CSV. Runs in the background with humanized pacing.",
  "permissions": ["storage", "tabs", "activeTab", "notifications", "downloads", "alarms"],
  "host_permissions": ["https://www.facebook.com/*", "https://*.facebook.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "FB Page Scraper",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://*.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}